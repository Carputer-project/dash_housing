    endloop
  endfacet
  facet normal 0 1 -0
    outer loop
      vertex 85 -50 3.005
      vertex -85 -50 5
      vertex 85 -50 5
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -85 -50 5
      vertex 85 -50 3.005
      vertex -85 -50 3.005
    endloop
  endfacet
endsolid OpenSCAD_Model
